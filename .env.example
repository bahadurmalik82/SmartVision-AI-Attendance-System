# Copy this file to ".env" and fill in your own values.
# NEVER commit a real .env file with passwords to GitHub.

# Flask secret key — REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development, if you leave this empty the app generates a random
# key each time it starts (sessions will not survive a restart).
SECRET_KEY=change-me-to-a-long-random-secret

# Database: leave unset to use local SQLite (data/attendance.db).
# For Hostinger MySQL, use e.g.:
# DATABASE_URL=<redacted>
DATABASE_URL=<redacted>

# App environment: development or production
FLASK_ENV=development

# --- Email (optional) ---
# Defaulter warning emails only work when these are set.
# Leave them empty and the app still works — the "Send Alert Email"
# button will just tell you email is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=<redacted>
SMTP_FROM=
SMTP_USE_TLS=true
